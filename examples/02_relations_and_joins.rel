#!rel 0.2
--
-- Rel Language Examples: 02 — Relations & Graph Navigation
-- JOIN は存在しない。
-- リレーションはスキーマに定義済みで、-> で辿るだけ。
--


-- ============================================================
-- 1. 基本的なリレーション探索
-- ============================================================

-- SQL: SELECT orders.id, users.name FROM orders JOIN users ON orders.user_id = users.id
--
-- Rel: JOIN キーを書く必要はない。スキーマ定義済みのリレーションを辿るだけ。
User -> .orders -> Order
=> { user.name, order.id }

-- 国で絞り込み
User { country: "Japan" } -> .orders -> Order
=> { user.name, order.id, order.amount }


-- ============================================================
-- 2. 多段階リレーション探索
-- ============================================================

-- SQL: JOIN users, orders, order_items, products (JOINキーを3回書く)
--
-- Rel: 矢印をつないで辿るだけ
User { country: "Japan" }
  -> .orders -> Order { status: Delivered }
  -> .items  -> OrderItem
  -> .product -> Product
=> { user.name, order.id, product.name, item.qty }

-- さらに深く（4段階）
User -> .orders -> .items -> Product -> .category -> Category { name: "Electronics" }
=> { user.name, product.name, category.name }


-- ============================================================
-- 3. 任意リレーション（LEFT JOIN 相当）
-- ============================================================

-- クーポンがないユーザーも含む
User -?> .coupon -> Coupon?
=> {
  user.name,
  discount: coupon?.rate ?? 0.0
}

-- プロフィール画像があるユーザーのみ（フィルタ）
User -?> .profile -> Profile { avatar_url: Some }
=> { user.name, profile.avatar_url! }


-- ============================================================
-- 4. リレーション上の制約
-- ============================================================

-- 辿るリレーションを条件でフィルタ
User -> .orders { status: Delivered, created_at > now() - 30d } -> Order
=> per(user) { user.name, recent_revenue: sum(order.amount) }

-- 高評価レビューのある商品のみ
Product -> .reviews { rating >= 4 } -> Review
=> per(product) {
  product.name,
  avg_rating: avg(review.rating),
  review_count: count(review)
}


-- ============================================================
-- 5. 逆方向リレーション
-- ============================================================

-- 注文 → 商品 という向きで、商品ごとに売上を集計
Order { status: Delivered } <- .items <- OrderItem -> .product -> Product
=> per(product) {
  product.name,
  units_sold: sum(item.qty),
  revenue:    sum(item.total_price)
}
sort (revenue desc)
take 10


-- ============================================================
-- 6. 自己参照（組織ツリー）
-- ============================================================

-- SQL:
--   WITH RECURSIVE sub AS (
--     SELECT *, 0 AS depth FROM employees WHERE id = $id
--     UNION ALL
--     SELECT e.*, s.depth+1 FROM employees e JOIN sub s ON e.manager_id = s.id
--     WHERE s.depth < 10
--   )
--   SELECT * FROM sub

-- Rel:（~> が再帰探索演算子）
Employee { id: $root_id } ~> .reports(depth: 0..10)
=> { .id, .name, .depth }

-- カテゴリの全祖先を辿る（下から上へ）
Category { id: $leaf_id } ~> .parent(depth: 0..20)
sort (.depth desc)
=> { .id, .name, .depth }


-- ============================================================
-- 7. 名前バインディング（同じ型が複数現れる場合）
-- ============================================================

-- フォロー関係（User -> User）
u: User { id: $user_id } -> .following -> v: User
=> { from: u.name, to: v.name }

-- 作成者と承認者がどちらも User
o: Order -> .creator  -> creator: User
         -?> .approver -> approver: User?
=> {
  o.id,
  creator_name:  creator.name,
  approver_name: approver?.name ?? "未承認"
}


-- ============================================================
-- 8. 多対多リレーション
-- ============================================================

-- ユーザーのタグ一覧（中間テーブルは意識しない）
User -> .tags -> Tag
=> per(user) {
  user.name,
  tags: collect(tag.name)
}

-- 特定タグを持つユーザー
User -> .tags -> Tag { name: "premium" }
=> { user.id, user.name, user.email }

-- タグごとにユーザーを集計
Tag -> .users -> User
=> per(tag) {
  tag_name:    tag.name,
  user_count:  count(user)
}
sort (user_count desc)


-- ============================================================
-- 9. 双方向リレーション（FULL OUTER JOIN 相当）
-- ============================================================

User <-> .orders <-> Order?
=> {
  user_id:   user?.id,
  user_name: user?.name,
  order_id:  order?.id,
  amount:    order?.amount
}


-- ============================================================
-- 10. ネストした形状（グラフ構造をそのまま返す）
-- ============================================================

-- ユーザーに、注文のリストをネストして返す
User { country: "Japan" }
=> {
  .id,
  .name,
  orders: .orders { status: Delivered } => [{
    .id,
    .amount,
    .created_at,
    items: .items => [{ product: .product.name, .qty, .unit_price }]
  }]
}

-- 結果の形:
-- {
--   id: "...", name: "田中",
--   orders: [
--     { id: "...", amount: 5000, items: [{ product: "iPhone", qty: 1, unit_price: 5000 }] }
--   ]
-- }


-- ============================================================
-- 11. 存在チェック（EXISTS / NOT EXISTS 相当）
-- ============================================================

-- 注文が存在するユーザーのみ
User { has(.orders) }
=> { .id, .name }

-- 一度も注文していないユーザー
User { lacks(.orders) }
=> { .id, .name }

-- 過去90日に注文があるユーザー
User { has(.orders { created_at > now() - 90d }) }
=> { .id, .name }


-- ============================================================
-- 12. SQLとの直接対応
-- ============================================================

-- SQL:
--   SELECT o.id, u.name, p.name AS product
--   FROM orders o
--   JOIN users u ON o.user_id = u.id
--   JOIN order_items oi ON o.id = oi.order_id
--   JOIN products p ON oi.product_id = p.id
--   WHERE u.country = 'JP'

-- Rel:
User { country: "JP" } -> .orders -> .items -> Product
=> { order.id, user.name, product.name }

-- SQL:
--   SELECT u.id, u.name, a.city
--   FROM users u
--   LEFT JOIN addresses a ON u.address_id = a.id

-- Rel:
User -?> .address -> Address?
=> { user.id, user.name, address?.city ?? "未登録" }
