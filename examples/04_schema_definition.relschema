#!rel 0.2
--
-- Rel Schema: ECサイトの完全なスキーマ定義
-- CREATE TABLE は存在しない。entity で宣言する。
--

module ecommerce {

-- ============================================================
-- 1. カスタム型定義
-- ============================================================

-- バリデーション付き型エイリアス
type Email    = String  check(is_email(.))
type Url      = String  check(is_url(.))
type Phone    = String  check(is_phone(.))
type Price    = Decimal(10,2) check(. >= 0)
type Quantity = Int check(. >= 0)

-- 埋め込み構造体型
type Address = {
  street:  String,
  city:    String,
  state:   String?,
  zip:     String,
  country: String    -- ISO 3166-1 alpha-2
}

type GeoPoint = { lat: Float, lon: Float }


-- ============================================================
-- 2. Enum定義
-- ============================================================

enum UserStatus   { Active, Inactive, Suspended, Deleted }
enum Plan         { Free, Standard, Premium, Enterprise }

-- データを持つバリアント（代数的データ型）
enum OrderStatus {
  Draft
  Pending
  Processing { started_at: Timestamp, worker_id: UUID? }
  Shipped    { tracking: String, carrier: String, eta: Date? }
  Delivered  { at: Timestamp, signature: String? }
  Cancelled  { reason: String, refund_amount: Price? }
  Refunded   { at: Timestamp, refund_id: String }
}

enum PaymentStatus { Pending, Captured, Failed, Refunded }


-- ============================================================
-- 3. エンティティ定義（CREATE TABLE の代わり）
-- ============================================================

entity User {
  id:            UUID           = gen_uuid_v7()
  email:         Email          unique indexed
  name:          String(200)    required
  display_name:  String(100)?
  avatar_url:    Url?
  phone:         Phone?         indexed
  status:        UserStatus     = Active
  plan:          Plan           = Free
  country:       String?
  address:       Address?
  timezone:      String         = "Asia/Tokyo"
  metadata:      Json           = {}
  created_at:    Timestamp      = now()
  updated_at:    Timestamp      = now()  auto_update
  deleted_at:    Timestamp?     indexed

  index [country, status]
  index [created_at desc]
  check(name != "")
}

entity Category {
  id:          UUID      = gen_uuid_v7()
  name:        String    required
  slug:        String    unique indexed
  description: String?
  image_url:   Url?
  parent_id:   UUID?     indexed
  sort_order:  Int       = 0
  is_active:   Bool      = true

  created_at:  Timestamp = now()
  updated_at:  Timestamp = now()  auto_update
}

entity Product {
  id:            UUID        = gen_uuid_v7()
  category_id:   UUID        indexed
  seller_id:     UUID        indexed
  name:          String(500) required
  description:   Text?
  price:         Price       check(. >= 0)
  original_price: Price?
  stock:         Quantity    = 0
  sku:           String?     unique
  images:        List<Url>   = []
  tags:          List<String> = []
  attributes:    Json        = {}
  is_active:     Bool        = true
  created_at:    Timestamp   = now()
  updated_at:    Timestamp   = now()  auto_update
  deleted_at:    Timestamp?

  index [category_id, is_active]
  index [price]
  check(stock >= 0)
}

entity Order {
  id:               UUID         = gen_uuid_v7()
  user_id:          UUID         indexed
  status:           OrderStatus  = Pending indexed
  subtotal:         Price
  shipping_fee:     Price        = 0
  tax_amount:       Price        = 0
  discount_amount:  Price        = 0
  total_amount:     Price        check(. >= 0)
  currency:         String       = "JPY"
  shipping_address: Address
  notes:            String?
  created_at:       Timestamp    = now()
  updated_at:       Timestamp    = now()  auto_update
  completed_at:     Timestamp?

  index [user_id, status]
  index [created_at desc]
}

entity OrderItem {
  id:          UUID      = gen_uuid_v7()
  order_id:    UUID      indexed
  product_id:  UUID      indexed
  qty:         Quantity  check(. > 0)
  unit_price:  Price
  total_price: Price     computed(qty * unit_price)
  snapshot:    Json      -- 注文時の商品情報スナップショット

  created_at:  Timestamp = now()
}

entity Payment {
  id:             UUID          = gen_uuid_v7()
  order_id:       UUID          unique indexed
  status:         PaymentStatus = Pending indexed
  amount:         Price
  currency:       String
  method:         Json          -- 支払い方法詳細
  external_id:    String?       indexed
  captured_at:    Timestamp?
  failed_at:      Timestamp?
  failure_reason: String?
  created_at:     Timestamp     = now()
  updated_at:     Timestamp     = now()  auto_update
}

entity Tag {
  id:    UUID   = gen_uuid_v7()
  name:  String unique required
  slug:  String unique
  color: String?    -- HEXカラーコード

  created_at: Timestamp = now()
}

entity Review {
  id:           UUID      = gen_uuid_v7()
  product_id:   UUID      indexed
  user_id:      UUID      indexed
  order_id:     UUID?
  rating:       Int       check(. >= 1 and . <= 5)
  title:        String?
  body:         Text?
  images:       List<Url> = []
  is_verified:  Bool      = false
  helpful_count: Int      = 0

  created_at:   Timestamp = now()
  updated_at:   Timestamp = now()  auto_update

  index [product_id, rating]
}


-- ============================================================
-- 4. リレーション定義
-- ============================================================

-- User のリレーション
User -> orders  -> Order[*]   via order.user_id
User -> reviews -> Review[*]  via review.user_id
User -> profile -> Profile?   via profile.user_id

-- 条件付きリレーション（アクティブな注文のみ）
User -> active_orders -> Order[*]
  via order.user_id
  where order.status in [Pending, Processing, Shipped]
  sort order.created_at desc

-- Category のリレーション（自己参照ツリー）
Category -> parent    -> Category?   via category.parent_id
Category -> children  -> Category[*] via category.parent_id
Category -> products  -> Product[*]  via product.category_id
Category -> ancestors -> Category[*] recursive via category.parent_id

-- Product のリレーション
Product -> category  -> Category   via product.category_id
Product -> seller    -> User       via product.seller_id
Product -> reviews   -> Review[*]  via review.product_id

-- Product <-> Tag 多対多
Product -> tags <-> Tag[*] via ProductTag {
  product_id: -> Product.id
  tag_id:     -> Tag.id
}

-- Order のリレーション
Order -> user    -> User        via order.user_id
Order -> items   -> OrderItem[*] via item.order_id
Order -> payment -> Payment?    via payment.order_id
Order -> creator -> User        via order.created_by
Order -?> approver -> User?     via order.approved_by

-- OrderItem のリレーション
OrderItem -> order   -> Order   via item.order_id
OrderItem -> product -> Product via item.product_id

-- Review のリレーション
Review -> product -> Product  via review.product_id
Review -> user    -> User     via review.user_id
Review -?> order  -> Order?   via review.order_id


-- ============================================================
-- 5. シャーディング設定
-- ============================================================

-- 注文はユーザーIDでシャーディング
Order {
  @shard(key: .user_id, strategy: hash, count: 256, replicas: 3)
}

-- イベントログは時系列でシャーディング
entity Event {
  id:          UUID      = gen_uuid_v7()
  user_id:     UUID?     indexed
  event_type:  String    indexed
  payload:     Json
  occurred_at: Timestamp indexed

  index [user_id, occurred_at desc]
  index [event_type, occurred_at desc]

  @shard(key: .occurred_at, strategy: range, count: 12, replicas: 2)
}


-- ============================================================
-- 6. マイグレーション定義
-- ============================================================

migration "2026-03-06/001-initial" {
  up {
    create User
    create Category
    create Product
    create ProductTag
    create Order
    create OrderItem
    create Payment
    create Tag
    create Review
    create Event
  }
  down {
    drop Event
    drop Review
    drop Tag
    drop Payment
    drop OrderItem
    drop Order
    drop ProductTag
    drop Product
    drop Category
    drop User
  }
}

migration "2026-03-06/002-add-product-weight" {
  up   { Product += { weight_g: Int?, dimensions: Json? } }
  down { Product -= weight_g, dimensions }
}

} -- end module ecommerce
