#!rel 0.2
--
-- Rel Language Examples: 06 — Distributed Queries & Stream Processing
-- 分散・ストリーム処理もパターン言語で統一的に記述する。
--

import std.time.*
import std.stats.*


-- ============================================================
-- 1. 分散クエリ（透過的分散）
-- ============================================================

-- 書き方は完全にシングルノードと同じ。
-- エンジンが自動的にシャードに分散して実行する。
Order { created_at > now() - 30d }
=> per(.country) {
  country: .country,
  revenue: sum(.amount),
  orders:  count()
}
sort (revenue desc)

-- 特定シャードへのヒント（チューニング時）
Order @shard_hint(.user_id, $user_id) { user_id: $user_id }
sort (.created_at desc)
take 20
=> { .id, .amount, .status, .created_at }


-- ============================================================
-- 2. シャーディング宣言（スキーマ側）
-- ============================================================

-- entity定義のシャーディング宣言で、クエリは変わらない
-- （参考: 04_schema_definition.relschema）
-- Order {
--   @shard(key: .user_id, strategy: hash, count: 256, replicas: 3)
-- }


-- ============================================================
-- 3. ストリーム定義
-- ============================================================

stream OrderEvent from kafka("orders-events") {
  schema: {
    order_id:  UUID,
    user_id:   UUID,
    amount:    Decimal(10,2),
    currency:  String,
    status:    String,
    country:   String,
    timestamp: Timestamp
  }
}

stream UserEvent from kafka("user-events") {
  schema: {
    user_id:    UUID,
    event_type: String,
    page_id:    String?,
    timestamp:  Timestamp
  }
}

stream SensorReading from mqtt("sensors/+/data") {
  schema: {
    sensor_id:   String,
    temperature: Float,
    humidity:    Float,
    recorded_at: Timestamp
  }
}


-- ============================================================
-- 4. ストリームクエリ — タンブリングウィンドウ
-- ============================================================

-- 1分ごとの国別売上
OrderEvent { status: "created" }
  window tumbling(1m)
  => per(.country) {
    window_start: window.start,
    country:      .country,
    orders:       count(),
    revenue:      sum(.amount)
  }
  -> sink kafka("revenue-by-minute")


-- ============================================================
-- 5. スライディングウィンドウ
-- ============================================================

-- 5分間の移動窓（1分スライド）— 高額ユーザーの検出
OrderEvent
  window sliding(size: 5m, step: 1m)
  => per(.user_id) {
    user_id:  .user_id,
    total:    sum(.amount),
    count:    count()
  } where total > 50000
  -> sink kafka("high-spend-alerts")


-- ============================================================
-- 6. セッションウィンドウ
-- ============================================================

UserEvent
  window session(gap: 30m)
  => per(.user_id) {
    user_id:     .user_id,
    start:       window.start,
    end:         window.end,
    duration:    window.duration / 60s,
    events:      count(),
    pages:       collect(distinct .page_id),
    converted:   any(.event_type == "purchase")
  }
  -> sink clickhouse("user_sessions")


-- ============================================================
-- 7. ストリームとバッチの結合（Stream-Table Join）
-- ============================================================

-- リアルタイムイベントに静的テーブルのデータを付加
OrderEvent
  enrich User on .user_id == user.id
  => {
    .order_id,
    .user_id,
    user.name,
    user.country,
    .amount,
    .timestamp
  }
  -> sink clickhouse("enriched_orders")


-- ============================================================
-- 8. 不正検知パイプライン
-- ============================================================

-- バッチ側: ユーザーの通常パターン（6時間ごとに更新）
@materialized(refresh: 6h)
def user_baseline =
  Order { created_at > now() - 90d } -> .user -> User
  => per(user) {
    user_id:       user.id,
    avg_amount:    avg(order.amount),
    stddev_amount: stddev(order.amount),
    usual_country: mode(user.country)
  }

-- ストリーム側: リアルタイム検知
OrderEvent
  enrich user_baseline on .user_id == baseline.user_id
  let z        = (.amount - baseline.avg_amount) / (baseline.stddev_amount + 0.01)
  let mismatch = .country != baseline.usual_country
  where z > 3.0 or mismatch
  => {
    .order_id,
    .user_id,
    .amount,
    z_score:          z,
    country_mismatch: mismatch,
    risk_level:       z > 5.0 ? "critical" : "high"
  }
  -> sink fraud_service("fraud-alerts")


-- ============================================================
-- 9. 複数シンクへの同時出力（tee）
-- ============================================================

OrderEvent { amount > 100000 }
  => { .order_id, .user_id, .amount, .timestamp }
  -> tee {
    sink kafka("high-value-orders"),
    sink clickhouse("high_value_log"),
    sink slack("#ops-alerts")
  }


-- ============================================================
-- 10. マルチリージョン集計
-- ============================================================

Order @regions(["us-east-1", "eu-west-1", "ap-northeast-1"])
  { created_at > now() - 1d }
  => per(.region, .country) {
    region:  .region,
    country: .country,
    revenue: sum(.amount),
    orders:  count()
  }
  sort (.region, revenue desc)


-- ============================================================
-- 11. 地理空間クエリ
-- ============================================================

import std.geo.*

-- 半径5km以内の店舗
Store
  where within_radius(.location, $user_location, 5.km)
  let dist = distance(.location, $user_location)
  sort (dist asc)
  take 10
  => { .id, .name, .address, distance_km: dist / 1000.0 }
