#!rel 0.2
--
-- Rel Language Examples: 03 — Aggregation & Analytics
-- GROUP BY は存在しない。
-- per() で「何単位で集計するか」を宣言する。
--

import std.time.*
import std.stats.*


-- ============================================================
-- 1. per() — 集計の基本
-- ============================================================

-- SQL: SELECT country, COUNT(*) FROM users GROUP BY country
--
-- Rel: "ユーザーを国ごとに集計する"
User
=> per(.country) {
  country: .country,
  count:   count()
}

-- SQL: SELECT status, country, COUNT(*), SUM(amount) FROM orders GROUP BY status, country
Order
=> per(.status, .country) {
  .status,
  .country,
  total:   count(),
  revenue: sum(.amount)
}


-- ============================================================
-- 2. エンティティ単位の集計
-- ============================================================

-- SQL:
--   SELECT u.id, u.name, COUNT(o.id), SUM(o.amount)
--   FROM users u JOIN orders o ON o.user_id = u.id
--   GROUP BY u.id, u.name

-- Rel: "ユーザーごとに注文を集計する"
User { country: "Japan" } -> .orders -> Order
=> per(user) {
  user.name,
  order_count:   count(order),
  total_revenue: sum(order.amount),
  avg_order:     avg(order.amount),
  last_order_at: max(order.created_at)
}


-- ============================================================
-- 3. HAVING 相当（集計後フィルタ）
-- ============================================================

-- SQL: ... HAVING COUNT(*) >= 100
User
=> per(.country) {
  .country,
  count: count()
} where count >= 100
sort (count desc)

-- 売上1億円以上のカテゴリ
Product -> .category -> Category
Order { status: Delivered } -> .items -> OrderItem -> .product -> Product
=> per(category) {
  category.name,
  revenue: sum(item.total_price)
} where revenue >= 100_000_000
sort (revenue desc)


-- ============================================================
-- 4. 複数レベルの集計
-- ============================================================

-- ユーザーごと・ステータスごと
User -> .orders -> Order
=> per(user, order.status) {
  user.name,
  status:  order.status,
  count:   count(order),
  revenue: sum(order.amount)
}

-- 日付ごと・国ごと
Order { status: Delivered }
=> per(.created_at.date, .country) {
  date:    .created_at.date,
  country: .country,
  revenue: sum(.amount),
  orders:  count()
}
sort (.date desc)


-- ============================================================
-- 5. 時系列集計
-- ============================================================

-- 日別売上
Order { status: Delivered }
=> per(.created_at.truncate("day")) {
  day:     .created_at.truncate("day"),
  revenue: sum(.amount),
  orders:  count()
}
sort (.day)

-- 月別
Order { status: Delivered, created_at > now() - 365d }
=> per(.created_at.truncate("month")) {
  month:   format(.created_at.truncate("month"), "YYYY-MM"),
  revenue: sum(.amount),
  orders:  count()
}
sort (.month)

-- 時間帯別
Order
=> per(.created_at.hour) {
  hour:    .created_at.hour,
  orders:  count(),
  revenue: sum(.amount)
}
sort (.hour)


-- ============================================================
-- 6. ウィンドウ関数
-- ============================================================

-- 注文をユーザーごとにランキング（直近順）
Order -> .user -> User
=> {
  user.name,
  order.amount,
  order.created_at,
  rank:          rank()          over user by order.created_at desc,
  running_total: sum(order.amount) over user by order.created_at
}

-- 前日比
-- （daily_stats はマテリアライズドパターン、後述）
daily_stats
=> {
  .date,
  .revenue,
  prev_day:   lag(.revenue, 1) over () by .date,
  day_over_day: (.revenue - lag(.revenue, 1) over () by .date)
                / lag(.revenue, 1) over () by .date * 100
}

-- パーセンタイルランク（国ごとの売上ランク）
Order -> .user -> User
=> {
  .id, .amount, user.country,
  pct_rank: percent_rank() over user.country by .amount
}


-- ============================================================
-- 7. コレクション集計
-- ============================================================

-- ユーザーの全タグをリストで収集
User -> .orders -> Order
=> per(user) {
  user.name,
  order_ids:      collect(order.id),
  order_statuses: collect(distinct order.status),
  has_cancelled:  any(order.status == Cancelled),
  all_delivered:  all(order.status == Delivered)
}


-- ============================================================
-- 8. 統計分析
-- ============================================================

Product
=> per(.category) {
  category:   .category,
  count:      count(),
  avg_price:  avg(.price),
  min_price:  min(.price),
  max_price:  max(.price),
  stddev:     stddev(.price),
  median:     median(.price),
  p25:        percentile(.price, 0.25),
  p75:        percentile(.price, 0.75),
  p95:        percentile(.price, 0.95)
}


-- ============================================================
-- 9. コホート分析
-- ============================================================

-- 登録月ごとのリテンション
User -> .orders -> Order
=> per(user.created_at.truncate("month"), order.created_at.truncate("month")) {
  cohort:         user.created_at.truncate("month"),
  activity_month: order.created_at.truncate("month"),
  month_offset:   diff_months(user.created_at, order.created_at),
  active_users:   count(distinct user.id)
}
sort (.cohort, .month_offset)


-- ============================================================
-- 10. SQLとの直接対応
-- ============================================================

-- SQL:
--   SELECT country, COUNT(*), AVG(age)
--   FROM users
--   WHERE status = 'active'
--   GROUP BY country
--   HAVING COUNT(*) > 100
--   ORDER BY COUNT(*) DESC

-- Rel:
User { status: Active }
=> per(.country) {
  country: .country,
  cnt:     count(),
  avg_age: avg(.age)
} where cnt > 100
sort (cnt desc)
