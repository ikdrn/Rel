#!rel 0.1
--
-- Rel Language Examples: 03 — Aggregation & Analytics
-- 集計・分析クエリの例
--

import std.datetime { now, date_trunc, format_date }
import std.stats    { percentile, correlation }


-- ============================================================
-- 1. 基本的なGROUP BY
-- ============================================================

-- SQL: SELECT country, COUNT(*) FROM users GROUP BY country
-- Rel:
from users
|> group by .country
|> select {
     country: .country,
     count:   count()
   }

-- 複数フィールドでのGROUP BY
from orders
|> group by .status, .country
|> select {
     .status,
     .country,
     total:   count(),
     revenue: sum(.amount)
   }


-- ============================================================
-- 2. HAVING（集計後フィルタ）
-- ============================================================

-- 100人以上のユーザーがいる国
from users
|> group by .country
|> having count() >= 100
|> select {
     .country,
     user_count: count()
   }
|> order by user_count desc

-- 売上1億円以上のカテゴリ
from order_items -> product -> category
|> group by category.name
|> having sum(order_items.quantity * product.price) >= 100000000
|> select {
     category:      category.name,
     total_revenue: sum(order_items.quantity * product.price)
   }
|> order by total_revenue desc


-- ============================================================
-- 3. 時系列集計
-- ============================================================

-- 日別売上
from orders
|> where .status == "completed"
|> group by date_trunc("day", .created_at) as day
|> select {
     day:           format_date(.day, "YYYY-MM-DD"),
     order_count:   count(),
     total_revenue: sum(.amount),
     avg_order:     avg(.amount)
   }
|> order by .day

-- 週別・月別比較
from orders
|> where .created_at >= now() - 365.days
|> group by {
     week:  date_trunc("week",  .created_at),
     month: date_trunc("month", .created_at)
   }
|> select {
     week:    .week,
     month:   .month,
     revenue: sum(.amount),
     orders:  count()
   }

-- 時間帯別分析
from orders
|> group by hour_of_day(.created_at) as hour
|> select {
     hour:          .hour,
     order_count:   count(),
     total_revenue: sum(.amount)
   }
|> order by .hour


-- ============================================================
-- 4. ウィンドウ関数
-- ============================================================

-- ユーザーごとの注文をランキング（最新が1位）
from orders
|> window {
     rank: rank() over (
       partition by .user_id
       order by .created_at desc
     )
   }
|> where .rank <= 3    -- 各ユーザーの直近3件のみ
|> select { .user_id, .id, .amount, .created_at, .rank }


-- 累積売上（ランニングトータル）
from orders
|> where .status == "completed"
|> order by .created_at
|> window {
     running_revenue: sum(.amount) over (
       order by .created_at
       rows unbounded preceding to current row
     ),
     running_count: count() over (
       order by .created_at
       rows unbounded preceding to current row
     )
   }
|> select {
     .created_at,
     .amount,
     .running_revenue,
     .running_count
   }


-- 前日比・前週比
from daily_revenue    -- マテリアライズドクエリ
|> window {
     prev_day_revenue:  lag(.revenue, 1) over (order by .date),
     prev_week_revenue: lag(.revenue, 7) over (order by .date)
   }
|> select {
     .date,
     .revenue,
     day_over_day:  (.revenue - .prev_day_revenue) / .prev_day_revenue * 100,
     week_over_week: (.revenue - .prev_week_revenue) / .prev_week_revenue * 100
   }


-- 移動平均（7日間）
from daily_revenue
|> window {
     moving_avg_7d: avg(.revenue) over (
       order by .date
       rows 6 preceding to current row
     )
   }
|> select { .date, .revenue, .moving_avg_7d }


-- パーセンタイル（ウィンドウ内）
from orders
|> window {
     percentile_rank: percent_rank() over (
       partition by .country
       order by .amount
     )
   }
|> select {
     .id,
     .amount,
     .country,
     top_10_percent: .percentile_rank >= 0.9
   }


-- ============================================================
-- 5. 統計分析
-- ============================================================

import std.stats { stddev, variance, median, percentile, correlation, z_score }

-- 基本統計量
from products
|> group by .category
|> select {
     category:    .category,
     count:       count(),
     avg_price:   avg(.price),
     min_price:   min(.price),
     max_price:   max(.price),
     stddev:      stddev(.price),
     median:      median(.price),
     p25:         percentile(.price, 0.25),
     p75:         percentile(.price, 0.75),
     p95:         percentile(.price, 0.95)
   }


-- ============================================================
-- 6. PIVOT（横展開）
-- ============================================================

-- 月別・カテゴリ別売上をPIVOT
from order_items -> product -> category -> orders
|> group by date_trunc("month", orders.created_at) as month, category.name
|> pivot {
     rows: .month,
     cols: category.name,
     value: sum(order_items.quantity * product.price),
     fill: 0.0
   }
|> select {
     month:       format_date(.month, "YYYY-MM"),
     electronics: .Electronics ?? 0,
     clothing:    .Clothing ?? 0,
     food:        .Food ?? 0
   }


-- ============================================================
-- 7. コホート分析
-- ============================================================

-- ユーザーコホート（登録月別のリテンション分析）
let user_cohorts =
  from users
  |> select {
       .id,
       cohort_month: date_trunc("month", .created_at)
     }

let user_activity =
  from orders -> user
  |> select {
       user.id,
       activity_month: date_trunc("month", orders.created_at)
     }
  |> distinct by (.id, .activity_month)

from user_cohorts -> user_activity on user_cohorts.id == user_activity.id
|> group by user_cohorts.cohort_month, user_activity.activity_month
|> select {
     cohort_month:   user_cohorts.cohort_month,
     activity_month: user_activity.activity_month,
     month_offset:   date_diff("month", user_cohorts.cohort_month, user_activity.activity_month),
     active_users:   count(distinct user_cohorts.id)
   }
|> order by user_cohorts.cohort_month, .month_offset


-- ============================================================
-- 8. ファネル分析
-- ============================================================

-- コンバージョンファネル（セッション → 商品閲覧 → カート → 購入）
from users
|> let viewed    = count(from page_views   |> where .user_id == users.id and .page_type == "product")
|> let carted    = count(from cart_events  |> where .user_id == users.id)
|> let purchased = count(from orders       |> where .user_id == users.id)
|> group by true    -- 全体集計
|> select {
     total_users:       count(),
     viewed_product:    count(viewed > 0),
     added_to_cart:     count(carted > 0),
     completed_purchase: count(purchased > 0),
     view_rate:         count(viewed > 0) / count() * 100,
     cart_rate:         count(carted > 0) / count(viewed > 0) * 100,
     purchase_rate:     count(purchased > 0) / count(carted > 0) * 100
   }
