#!rel 0.2
--
-- Rel Language Examples: 05 — Named Patterns & Modules
-- クエリの再利用は def で定義する。
-- VIEW や Stored Procedure の代わりになる。
--


-- ============================================================
-- 1. def — 名前付きパターンの定義
-- ============================================================

-- 基本パターン（引数なし）
def active_users =
  User { status: Active, deleted_at: None }

-- 合成（active_users を拡張）
def adult_users   = active_users { age >= 18 }
def premium_users = active_users { plan: Premium | plan: Enterprise }
def japan_users   = active_users { country: "Japan" }

-- さらに合成
def japan_premium = japan_users { plan: Premium | plan: Enterprise }

-- 使い方（通常のエンティティパターンと同じ）
japan_premium
sort (.name)
=> { .id, .name, .email }


-- ============================================================
-- 2. パラメータ付きパターン
-- ============================================================

-- 引数を取るパターン
def users_in(country: String) = active_users { country }

def orders_since(days: Int) =
  Order {
    created_at > now() - days.d,
    status: Delivered
  }

def products_under(max_price: Price) =
  Product { price < max_price, is_active: true, stock > 0 }

-- 使用例
users_in("Japan") -> .orders -> orders_since(30)
=> per(user) { user.name, revenue: sum(order.amount) }
sort (revenue desc)
take 10


-- ============================================================
-- 3. パターンの合成・ネスト
-- ============================================================

-- ソート・ページング込みのパターン
def top_customers(limit: Int = 10, days: Int = 30) =
  User -> .orders -> orders_since(days)
  => per(user) {
    user.name,
    user.email,
    total:  sum(order.amount),
    count:  count(order)
  }
  sort (total desc)
  take limit

-- 使用
top_customers(limit: 5, days: 90)

-- 国別トップ
users_in("Japan") -> .orders -> orders_since(30)
=> per(user) {
  user.name,
  total: sum(order.amount)
}
sort (total desc)
take 10


-- ============================================================
-- 4. マテリアライズドパターン（事前計算・キャッシュ）
-- ============================================================

-- 定期更新でキャッシュ（重いクエリを事前計算）
@materialized(refresh: 1h)
def daily_stats =
  Order { status: Delivered }
  => per(.created_at.date) {
    date:    .created_at.date,
    revenue: sum(.amount),
    orders:  count()
  }
  sort (.date)

@materialized(refresh: 6h)
def product_ranking =
  OrderItem -> .product -> Product
  => per(product) {
    product.id,
    product.name,
    units_sold: sum(item.qty),
    revenue:    sum(item.total_price)
  }
  sort (revenue desc)

-- マテリアライズドパターンは通常と同じように使える
daily_stats { date > now() - 30d }
=> { .date, .revenue }


-- ============================================================
-- 5. モジュール定義
-- ============================================================

module analytics {
  import ecommerce.*
  import std.time.*

  -- エクスポートしたパターンは外部から使える
  export def active_users = User { status: Active }

  export def revenue_by_country =
    Order { status: Delivered } -> .user -> User
    => per(user.country) {
      country: user.country,
      revenue: sum(order.amount),
      orders:  count(order)
    }
    sort (revenue desc)

  export def top_products(n: Int = 10) =
    OrderItem -> .product -> Product
    => per(product) {
      product.name,
      product.category,
      units:   sum(item.qty),
      revenue: sum(item.total_price)
    }
    sort (revenue desc)
    take n

  @materialized(refresh: 1h)
  export def daily_kpi =
    Order { status: Delivered }
    => per(.created_at.date) {
      date:    .created_at.date,
      revenue: sum(.amount),
      orders:  count(),
      avg:     avg(.amount)
    }

  -- プライベート（export なし）
  def _base = Order { status: Delivered }
}


-- ============================================================
-- 6. モジュールの使用
-- ============================================================

import analytics.revenue_by_country
import analytics { top_products, daily_kpi }
import analytics as an

-- 使用
revenue_by_country take 5

top_products(n: 20)

an.daily_kpi { date > now() - 7d }
=> { .date, .revenue, .orders }


-- ============================================================
-- 7. 動的パターン（条件付きフィルタ）
-- ============================================================

-- 引数に応じてフィルタが変わるパターン
def search_products(
  keyword:       String?  = None,
  category_id:   UUID?    = None,
  min_price:     Price?   = None,
  max_price:     Price?   = None,
  in_stock_only: Bool     = false
) =
  Product {
    is_active:   true,
    name:        keyword   != None ? ~ keyword! : any,
    category_id: category_id != None ? category_id! : any,
    price:       min_price != None ? >= min_price! : any,
    price:       max_price != None ? <= max_price! : any,
    stock:       in_stock_only ? > 0 : any
  }
  sort (.created_at desc)

-- 使用
search_products(
  keyword:      "スマートフォン",
  min_price:    50000,
  max_price:    100000,
  in_stock_only: true
)
=> { .id, .name, .price, .stock }


-- ============================================================
-- 8. トランザクション内でのパターン使用
-- ============================================================

transaction create_order($user_id: UUID, $items: List<{product_id: UUID, qty: Int}>) {
  isolation: Serializable
  timeout:   30s

  let user = active_users { id: $user_id } one

  -- 在庫確保（ロック付き）
  for item in $items {
    let product = Product { id: item.product_id } lock(write) one
    guard product.stock >= item.qty else InsufficientStock { available: product.stock }
    product update { stock: product.stock - item.qty }
  }

  let total = $items.sum(|i| {
    let p = Product { id: i.product_id } one
    p.price * i.qty
  })

  let order = create Order {
    user_id:          $user_id,
    total_amount:     total,
    shipping_address: user.address!
  }

  for item in $items {
    let p = Product { id: item.product_id } one
    create OrderItem {
      order_id:   order.id,
      product_id: item.product_id,
      qty:        item.qty,
      unit_price: p.price,
      snapshot:   { name: p.name, price: p.price }
    }
  }

  return { order_id: order.id, total }
}
