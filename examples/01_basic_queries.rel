#!rel 0.2
--
-- Rel Language Examples: 01 — Basic Queries
-- select/from/where は存在しない。
-- エンティティパターン + => 抽出で記述する。
--


-- ============================================================
-- 1. エンティティパターンの基本
-- ============================================================

-- すべてのユーザー（FROM users に相当するが、テーブルではなくエンティティ）
User

-- 条件付き（WHERE は使わない。{} の中に書く）
User { age > 18 }

-- 複数条件（AND はカンマ）
User { age > 18, country: "Japan" }

-- OR 条件
User { country: "Japan" | country: "Korea" }

-- ネストした AND/OR
User { age >= 18, plan: "premium" | plan: "enterprise" }


-- ============================================================
-- 2. フィールド抽出（SELECT の代わりに => を使う）
-- ============================================================

-- 全フィールド
User { age > 18 }
=> .

-- 特定フィールドを選ぶ
User { age > 18 }
=> { .id, .name, .email }

-- フィールドに別名をつける
User { age > 18 }
=> { id: .id, full_name: .name, contact: .email }

-- 計算フィールド
User
=> { .name, label: .name ++ " (" ++ .country ++ ")" }

-- 条件式（三項演算子）
User
=> {
  .name,
  .age,
  tier: .age >= 65 ? "senior" : .age >= 18 ? "adult" : "minor"
}


-- ============================================================
-- 3. パターン記法の詳細
-- ============================================================

-- 一致チェック（: は == と同じ）
User { status: Active }

-- 比較演算子
User { price >= 1000, price <= 5000 }

-- Option フィールドの存在チェック
User { phone: Some }          -- phone が存在する（IS NOT NULL 相当）
User { phone: None }          -- phone が存在しない（IS NULL 相当）

-- リストに含まれる
User { country: in ["Japan", "Korea", "Singapore"] }

-- 正規表現
User { name: ~ /^田/ }

-- リレーション先の存在チェック
User { has(.orders) }         -- 注文がある
User { lacks(.orders) }       -- 一度も注文していない
User { .orders.count > 3 }    -- 3件より多い注文がある


-- ============================================================
-- 4. ソートとページング
-- ============================================================

-- ソート
User { age > 18 }
sort (.name asc)
=> { .id, .name }

-- 複数ソート
User
sort (.country asc, .age desc)
=> { .name, .country, .age }

-- ページング（オフセットベース）
User { age > 18 }
sort (.created_at desc)
take 20, skip 40
=> { .id, .name }

-- ページング（カーソルベース、分散環境推奨）
User
sort (.created_at desc, .id desc)
after $cursor
take 20
=> { .id, .name, .created_at }

-- 1件だけ取得
User { id: $id } one
=> { .id, .name, .email }

-- 最初の1件（存在しない場合は None）
User { email: $email } first
=> { .id, .name }


-- ============================================================
-- 5. 日時・計算を使ったパターン
-- ============================================================

import std.time.*

-- 過去30日以内に作成されたユーザー
User { created_at > now() - 30d }
=> { .id, .name, .created_at }

-- 過去1年以内に更新されていないユーザー
User { updated_at < now() - 365d, status: Active }
=> { .id, .name, .updated_at }


-- ============================================================
-- 6. 文字列操作
-- ============================================================

import std.string.*

User { age > 18 }
=> {
  .id,
  name_upper:   upper(.name),
  email_domain: split(.email, "@")[1],
  name_len:     length(.name)
}


-- ============================================================
-- 7. Optionの操作
-- ============================================================

User
=> {
  .name,
  -- None のときはデフォルト値
  phone:    .phone ?? "未登録",
  -- オプショナルチェーン（None なら None のまま）
  phone_up: .phone?.to_upper() ?? "N/A"
}

-- パターンマッチ
User { age > 18 }
=> {
  .name,
  contact: .phone match {
    Some(p) => "TEL: " ++ p,
    None    => "Email: " ++ .email
  }
}


-- ============================================================
-- 8. 配列フィールドの操作
-- ============================================================

Product { is_active: true }
=> {
  .id,
  .name,
  .tags,
  has_sale_tag:  .tags.contains("sale"),
  tag_count:     .tags.length(),
  first_tag:     .tags.first() ?? "none"
}


-- ============================================================
-- 9. SQLとの直接対応
-- ============================================================

-- SQL: SELECT id, name FROM users WHERE age > 18 ORDER BY name LIMIT 10
User { age > 18 }
sort (.name)
take 10
=> { .id, .name }

-- SQL: SELECT DISTINCT country FROM users
User
sort (.country)
=> { .country }  -- per(.country) で重複除外になる（後述）

-- SQL: SELECT COUNT(*) FROM users WHERE status = 'active'
User { status: Active } count()

-- SQL: SELECT * FROM users WHERE phone IS NOT NULL
User { phone: Some }
=> .

-- SQL: SELECT *, COALESCE(phone, 'N/A') FROM users
User
=> { ., phone_display: .phone ?? "N/A" }
